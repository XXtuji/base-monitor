# Optional: official X API v2 token for @aleabitoreddit monitoring.
# Do not commit your real token.
X_BEARER_TOKEN=

# Optional: custom RSS/Nitter-compatible feed URL.
# Use {handle} as the username placeholder.
SERENITY_X_RSS_URL=

# Optional cache TTL for the monitor endpoint.
SERENITY_MONITOR_TTL_SECONDS=90

# Optional: official FRED API key for the macro panel.
FRED_API_KEY=

# Optional cache TTL for FRED macro data.
SERENITY_FRED_TTL_SECONDS=3600

# Optional cache TTL for Open Cabinet / OGE political trade disclosures.
SERENITY_POLITICAL_TRADES_TTL_SECONDS=21600

# Optional cache TTL for congressional trading disclosures.
SERENITY_CONGRESS_TRADES_TTL_SECONDS=900

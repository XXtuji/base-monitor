+def postprocess_zh_translation(text):
+    value = html.unescape(text or "").strip()
+    value = re.sub(r"\s+", " ", value)
+    for src, dst in TRANSLATION_REPLACEMENTS:
+        value = value.replace(src, dst)
+    value = value.replace(" - ", " - ")
+    return value
+
